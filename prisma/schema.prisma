// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clients       Client[]
  collaborators Collaborator[]
  services      Service[]
  appointments  Appointment[]
  payments      Payment[]
  resources     Resource[]
  financialCategories FinancialCategory[]
  financialEntries FinancialEntry[]
  financialMonthlySummaries FinancialMonthlySummary[]
}

model Client {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  email        String?
  phone        String?
  birthDate    DateTime?
  cpf          String?
  address      String?
  notes        String?
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  payments     Payment[]

  @@index([tenantId])
}

model Collaborator {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  role           String
  specialty      String?
  commissionRate Decimal?      @db.Decimal(5, 2)
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  appointments        Appointment[]
  commissionPayments  CommissionPayment[]

  @@index([tenantId])
}

model CommissionPayment {
  id             String       @id @default(cuid())
  tenantId       String
  collaboratorId String
  amount         Decimal      @db.Decimal(10, 2)
  type           String       @default("payment") // payment | advance
  notes          String?
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])

  @@index([tenantId])
  @@index([collaboratorId])
  @@index([paidAt])
}

model Service {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  duration     Int
  price        Decimal       @db.Decimal(10, 2)
  category     String?
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@index([tenantId])
}

model Appointment {
  id             String       @id @default(cuid())
  tenantId       String
  clientId       String
  collaboratorId String
  serviceId      String
  startDateTime  DateTime
  endDateTime    DateTime
  status         String       @default("scheduled")
  notes          String?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  client         Client       @relation(fields: [clientId], references: [id])
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])
  payments       Payment[]
  resources      AppointmentResource[]

  @@index([tenantId])
  @@index([clientId])
  @@index([collaboratorId])
  @@index([serviceId])
  @@index([startDateTime])
}

model Notification {
  id          String    @id @default(cuid())
  tenantId    String
  type        String    // appointment_reminder | payment_pending | appointment_cancelled
  recipient   String    // email address
  title       String
  message     String
  status      String    @default("pending") // pending | sent | failed | cancelled
  appointmentId String?
  sentAt      DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([appointmentId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  userEmail  String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Payment {
  id                  String      @id @default(cuid())
  tenantId            String
  clientId            String
  appointmentId       String?
  amount              Decimal     @db.Decimal(10, 2)
  paymentMethod       String?
  status              String      @default("pending")
  paidAt              DateTime?
  dueDate             DateTime?
  notes               String?
  invoiceStatus       String      @default("not_issued")
  invoiceExternalUrl  String?
  invoiceNumber       String?
  isDeleted           Boolean     @default(false)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  client              Client      @relation(fields: [clientId], references: [id])
  appointment         Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([dueDate])
}

model Resource {
  id           String               @id @default(cuid())
  tenantId     String
  name         String
  type         String               // room | equipment | gym
  capacity     Int                  @default(1)
  isActive     Boolean              @default(true)
  isDeleted    Boolean              @default(false)
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  appointments AppointmentResource[]

  @@index([tenantId])
}

model FinancialCategory {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  group        String
  type         String
  calculationType String @default("operational_expense")
  defaultValue Decimal? @db.Decimal(10, 2)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  entries      FinancialEntry[]

  @@index([tenantId])
  @@index([group])
  @@index([type])
  @@index([calculationType])
  @@index([order])
}

model FinancialEntry {
  id           String   @id @default(cuid())
  tenantId     String
  categoryId   String
  year         Int
  month        Int
  plannedValue Decimal? @db.Decimal(10, 2)
  actualValue  Decimal? @db.Decimal(10, 2)
  description  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  category     FinancialCategory @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, categoryId, year, month])
  @@index([tenantId])
  @@index([categoryId])
  @@index([year, month])
}

model FinancialMonthlySummary {
  id                      String   @id @default(cuid())
  tenantId                String
  year                    Int
  month                   Int
  manualRevenueAdjustment Decimal? @db.Decimal(10, 2)
  savingsAmount           Decimal? @db.Decimal(10, 2)
  carriedBalance          Decimal? @db.Decimal(10, 2)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([year, month])
}

model AppointmentResource {
  id            String      @id @default(cuid())
  appointmentId String
  resourceId    String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  resource      Resource    @relation(fields: [resourceId], references: [id])

  @@unique([appointmentId, resourceId])
}
